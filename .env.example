# Environment Variables

# AI Studio / Gemini API Key
GEMINI_API_KEY=
PORT=3000

# ==============================================================================
# SERVICIO DE CORREOS TRANSACCIONALES (RESEND)
# ==============================================================================
# API Key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Dirección remitente autorizada.
# Por defecto utiliza 'Lidacta <onboarding@resend.dev>' (Modo Sandbox de Resend).
# NOTA IMPORTANTE SOBRE SANDBOX: Con 'onboarding@resend.dev', Resend únicamente permite
# entregar correos a la cuenta registrada del propietario (ADMIN_EMAIL).
# Para enviar correos a cualquier destinatario externo (ej. Gmail, Outlook, dominios corporativos),
# verifica un dominio en https://resend.com/domains y define esta variable:
# Ejemplo: RESEND_FROM_EMAIL="Lidacta <notificaciones@taniapadierna.com>"
RESEND_FROM_EMAIL="Lidacta <onboarding@resend.dev>"

# Correo del Administrador principal y propietario de la cuenta de pruebas Resend
ADMIN_EMAIL=hola@taniapadierna.com

# ElevenLabs Text-to-Speech (Cloned Voice 'Lidacta Mentora')
NEXT_PUBLIC_ELEVENLABS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=4pxgXWex1CwQ1I4uyCVG

# ==============================================================================
# VERCEL PERSISTENCE / STORAGE OPTIONS (Elija una de las siguientes opciones):
# ==============================================================================

# OPCIÓN A (Recomendada para Vercel): Vercel KV / Upstash Redis
# Si añades una base de datos KV desde Vercel Dashboard (Storage -> Create Database -> KV),
# Vercel inyecta automáticamente estas dos variables en tu proyecto:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Si usas Upstash Redis directamente:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OPCIÓN B: Supabase (PostgreSQL / BaaS)
# Si conectas Supabase en Vercel Marketplace o manualmente:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# o SUPABASE_KEY=

# OPCIÓN C: Vercel Postgres / Neon
POSTGRES_URL=
